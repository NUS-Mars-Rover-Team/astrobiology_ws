# A command with no arguments that takes time to finish.
# Servers: /astrobiology/gantry/home, /astrobiology/gantry/scan, /astrobiology/gantry/handover,
#          /astrobiology/gantry/lid, /astrobiology/gantry/unlid  [steppers_node]
---
bool    success         # accepted, not finished
string  message         # reason if rejected
float32 expected_s      # estimated time to finish; 0 if rejected
