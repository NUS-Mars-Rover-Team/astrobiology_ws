# Run a peristaltic pump for a set volume. No flow sensor: run time = volume / calibrated flow rate.
# Servers: /astrobiology/pump/dispense (extraction, firmware p),
#          /astrobiology/flush/dispense (dosing, firmware f)  [steppers_node]

float32 volume_ml
---
bool    success         # accepted, not finished
string  message         # reason if rejected
float32 expected_s      # estimated time to finish; 0 if rejected
