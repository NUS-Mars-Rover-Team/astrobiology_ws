// Astrobiology ROS 2 architecture, laid out like rqt_graph:
//   hardware -> node (ellipse) -> topic (box) -> subscriber
// Every service is listed in the table beside the node that serves it.
// Render: dot -Tpng architecture.dot -o architecture.png
//     or: dot -Tsvg architecture.dot -o architecture.svg
//     or: paste into https://dreampuf.github.io/GraphvizOnline

digraph astrobiology {
    rankdir=LR;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=11];
    edge [fontname="Helvetica", fontsize=9];
    bgcolor="white";
    pad=0.3;
    nodesep=0.25;
    ranksep=0.6;

    // ── Hardware ──────────────────────────────────────────────
    node [shape=box3d, style=filled, fillcolor="#FFE0B2"];
    esp_steppers  [label="ESP32 stepper controller\nSixMotorController.ino\npump, flush, centrifuge, x, y, z"];
    esp_lights    [label="Arduino lights\nLEDdrill.ino\nUVM, UVC, laser, halogen"];
    arduino_drill [label="Arduino drill\nLAdrill.ino"];
    btc100        [label="B&W Tek BTC100\nRaman spectrometer"];
    spectro_cam   [label="Sonix spectroscope\ncamera"];

    // ── Nodes ─────────────────────────────────────────────────
    node [shape=ellipse, style=filled, fillcolor="#BBDEFB"];
    steppers_node [label="/steppers_node"];
    lights_node   [label="/lights_node"];
    drill_node    [label="/drill_node"];
    raman_node    [label="/raman/raman_node"];
    spectrum_node [label="/spectro/spectrum_node"];

    // ── Topics ────────────────────────────────────────────────
    node [shape=box, style="filled,rounded", fillcolor="#C8E6C9"];
    gantry_position  [label="/astrobiology/gantry/position\ngeometry_msgs/Point (mm)"];
    carousel_angle   [label="/astrobiology/carousel/angle\nstd_msgs/Float32 (deg)"];
    raman_spectrum   [label="/raman/spectrum\nastrobiology_msgs/RamanSpectrum"];
    spectro_spectrum [label="/spectro/spectrum\nastrobiology_msgs/Spectrum"];
    spectro_preview  [label="/spectro/preview/compressed\nsensor_msgs/CompressedImage"];

    // ── Subscribers ───────────────────────────────────────────
    node [shape=ellipse, style=filled, fillcolor="#E3F2FD"];
    spectrum_plot [label="/spectrum_plot\n(diagnostic)"];
    rover_gui     [label="/rover_gui\n(Mars-Rover-GUI, planned)", style="filled,dashed"];

    // ── Services: one table per node, every service listed ────
    node [shape=plain, fontsize=9.5];
    steppers_srv [label=<
      <table border="0" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F3E5F5" color="#6A1B9A">
        <tr><td colspan="4" align="left" bgcolor="#E1BEE7"><b>/steppers_node services</b>  (prefix /astrobiology/)</td></tr>
        <tr>
          <td align="left" valign="top"><i>gantry jobs</i><br align="left"/>gantry/home · Command<br align="left"/>gantry/scan · Command<br align="left"/>gantry/handover · Command<br align="left"/>gantry/lid · Command<br align="left"/>gantry/unlid · Command<br align="left"/>gantry/dock_pipes · Command<br align="left"/>gantry/stop · Trigger<br align="left"/></td>
          <td align="left" valign="top"><i>gantry axes</i><br align="left"/>gantry/x/move · MoveAxis<br align="left"/>gantry/y/move · MoveAxis<br align="left"/>gantry/z/move · MoveAxis<br align="left"/>gantry/x/stop · Trigger<br align="left"/>gantry/y/stop · Trigger<br align="left"/>gantry/z/stop · Trigger<br align="left"/></td>
          <td align="left" valign="top"><i>pumps</i><br align="left"/>pump/move · StepperMove<br align="left"/>pump/dispense · Dispense<br align="left"/>pump/stop · Trigger<br align="left"/>flush/move · StepperMove<br align="left"/>flush/dispense · Dispense<br align="left"/>flush/stop · Trigger<br align="left"/></td>
          <td align="left" valign="top"><i>centrifuge / carousel</i><br align="left"/>centrifuge/move · StepperMove<br align="left"/>centrifuge/spin · Spin<br align="left"/>centrifuge/stop · Trigger<br align="left"/>carousel/rotate · Rotate<br align="left"/>carousel/home · Trigger<br align="left"/></td>
        </tr>
      </table>
    >];
    lights_srv [label=<
      <table border="0" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F3E5F5">
        <tr><td align="left" bgcolor="#E1BEE7"><b>/lights_node services</b></td></tr>
        <tr><td align="left">/astrobiology/uvm/set · SetBool<br align="left"/>/astrobiology/uvc/set · SetBool<br align="left"/>/astrobiology/laser/set · SetBool<br align="left"/>/astrobiology/halogen/set · SetBool<br align="left"/></td></tr>
      </table>
    >];
    drill_srv [label=<
      <table border="0" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F3E5F5">
        <tr><td align="left" bgcolor="#E1BEE7"><b>/drill_node services</b></td></tr>
        <tr><td align="left">/astrobiology/drill/start · Trigger<br align="left"/>/astrobiology/drill/stop · Trigger<br align="left"/></td></tr>
      </table>
    >];
    raman_srv [label=<
      <table border="0" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F3E5F5">
        <tr><td align="left" bgcolor="#E1BEE7"><b>/raman/raman_node services</b></td></tr>
        <tr><td align="left">/raman/start · Trigger<br align="left"/>/raman/stop · Trigger<br align="left"/>/raman/set_dark · Trigger<br align="left"/>/raman/clear_dark · Trigger<br align="left"/></td></tr>
      </table>
    >];
    spectro_srv [label=<
      <table border="0" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F3E5F5">
        <tr><td align="left" bgcolor="#E1BEE7"><b>/spectro/spectrum_node services</b></td></tr>
        <tr><td align="left">/spectro/spectrum_node/set_zero_reference · Trigger<br align="left"/>/spectro/spectrum_node/clear_zero_reference · Trigger<br align="left"/></td></tr>
      </table>
    >];

    // ── Hardware -> nodes (serial / V4L2) ─────────────────────
    edge [color="#E65100", style=bold];
    esp_steppers  -> steppers_node [label="/dev/esp_steppers\n115200, g1"];
    esp_lights    -> lights_node   [label="/dev/esp_lights\n9600"];
    arduino_drill -> drill_node    [label="/dev/uno_drill\n9600"];
    btc100        -> raman_node    [label="/dev/raman_spectroscope\n115200"];
    spectro_cam   -> spectrum_node [label="/dev/spectroscope\nV4L2"];

    // ── Nodes -> topics -> subscribers ────────────────────────
    edge [color="#2E7D32", style=solid, label=""];
    steppers_node -> gantry_position;
    steppers_node -> carousel_angle;
    raman_node    -> raman_spectrum;
    spectrum_node -> spectro_spectrum;
    spectrum_node -> spectro_preview;
    spectro_spectrum -> spectrum_plot;

    edge [color="#2E7D32", style=dashed];
    gantry_position  -> rover_gui;
    carousel_angle   -> rover_gui;
    raman_spectrum   -> rover_gui;
    spectro_spectrum -> rover_gui;

    // ── Nodes -> their services ───────────────────────────────
    edge [color="#6A1B9A", style=dotted, arrowhead=none];
    steppers_node -> steppers_srv;
    lights_node   -> lights_srv;
    drill_node    -> drill_srv;
    raman_node    -> raman_srv;
    spectrum_node -> spectro_srv;

    // ── Legend ────────────────────────────────────────────────
    subgraph cluster_legend {
        label="Legend"; fontsize=10; style=rounded; color="#9E9E9E"; fontcolor="#616161";
        leg_hw    [label="hardware", shape=box3d, style=filled, fillcolor="#FFE0B2", fontsize=9];
        leg_node  [label="ROS node", shape=ellipse, style=filled, fillcolor="#BBDEFB", fontsize=9];
        leg_topic [label="topic", shape=box, style="filled,rounded", fillcolor="#C8E6C9", fontsize=9];
        leg_srv   [label="services\n(the GUI calls these)", shape=box, style=filled, fillcolor="#F3E5F5", fontsize=9];
        leg_sub   [label="planned subscriber", shape=ellipse, style="filled,dashed", fillcolor="#E3F2FD", fontsize=9];
        leg_hw -> leg_node -> leg_topic -> leg_srv -> leg_sub [style=invis];
    }
}
